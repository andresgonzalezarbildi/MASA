{
  "name": "masa",
  "private": true,
  "version": "31.0.7",
  "type": "module",
  "scripts": {
    "mobile:prepare": "node tools/prepare-mobile.mjs",
    "android:init": "npm run mobile:prepare && npx cap add android && npm run android:assets && node tools/configure-android.mjs && npx cap sync android",
    "android:sync": "npm run mobile:prepare && npm run android:assets && npx cap sync android && node tools/configure-android.mjs",
    "android:open": "npm run android:sync && npx cap open android",
    "android:apk": "node tools/build-android.mjs",
    "android:assets": "npx @capacitor/assets generate --android --assetPath resources --iconBackgroundColor '#15181d' --iconBackgroundColorDark '#15181d' --splashBackgroundColor '#f2efe7' --splashBackgroundColorDark '#15181d'",
    "test:auth": "node tools/test-auth-flow.mjs",
    "test:mobile-html": "node tools/test-mobile-html.mjs",
    "test": "npm run test:auth && npm run test:mobile-html && npm run test:android-navigation",
    "supabase:auth-config": "node tools/configure-supabase-auth.mjs",
    "test:labels": "node tools/test-nutrition-label-parser.mjs",
    "test:android-navigation": "node tools/test-android-navigation.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/barcode-scanner": "3.1.0",
    "@capacitor/core": "8.4.2",
    "@supabase/supabase-js": "2.110.9"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "esbuild": "0.28.1",
    "supabase": "^2.111.0"
  }
}
